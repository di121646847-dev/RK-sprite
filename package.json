{
  "name": "rk-sprite",
  "version": "0.1.0",
  "private": true,
  "description": "Offline sprite animation and outfit authoring desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/smoke.mjs",
    "smoke:atlas": "node tests/atlas-smoke.mjs",
    "smoke:drop": "node tests/drop-recent.mjs",
    "smoke:history": "node tests/history-smoke.mjs",
    "smoke:playback": "node tests/playback-loop.mjs",
    "smoke:features": "node tests/features-smoke.mjs",
    "smoke:guides": "node tests/guides-smoke.mjs",
    "test:close": "node tests/close.mjs",
    "package:win": "electron-packager . \"RK sprite\" --platform=win32 --arch=x64 --out=out/build --overwrite --ignore=\"^/out($|/)\" --ignore=\"^/tests($|/)\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "44.5.1",
    "playwright": "^1.58.2"
  },
  "dependencies": {
    "lucide": "^0.468.0"
  }
}
